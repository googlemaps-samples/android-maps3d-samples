<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/control_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:cardCornerRadius="16dp"
    android:layout_margin="12dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <!-- Card Header with title and collapse/expand button -->
        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            >

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/routes_controls_title"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textStyle="bold"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_collapse"
                style="?attr/materialIconButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                app:icon="@drawable/expand_more_24px"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/collapse_controls"
                />
        </LinearLayout>

        <!-- Collapsible Content Section -->
        <LinearLayout
            android:id="@+id/card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            >

            <!-- Playback Control Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_pause"
                    style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/play_arrow_24px"
                    android:contentDescription="@string/play_or_pause_route_animation"
                    />

                <com.google.android.material.slider.Slider
                    android:id="@+id/progress_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:valueFrom="0.0"
                    android:valueTo="1.0"
                    android:value="0.0"
                    app:labelBehavior="gone"
                    />
            </LinearLayout>

            <!-- Camera Range / Altitude Control -->
            <TextView
                android:id="@+id/range_slider_label"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="Camera Altitude: 1500m"
                />

            <com.google.android.material.slider.Slider
                android:id="@+id/range_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="200.0"
                android:valueTo="5000.0"
                android:value="1500.0"
                app:labelBehavior="gone"
                />

            <!-- Animation Speed Control -->
            <TextView
                android:id="@+id/speed_slider_label"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Vehicle Speed: 150m/s"
                />

            <com.google.android.material.slider.Slider
                android:id="@+id/speed_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="10.0"
                android:valueTo="500.0"
                android:value="150.0"
                app:labelBehavior="gone"
                />

            <!-- Camera Heading Offset Control -->
            <TextView
                android:id="@+id/heading_slider_label"
                style="@style/TextAppearance.Material3.LabelMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="Camera Yaw Offset: 0°"
                />

            <com.google.android.material.slider.Slider
                android:id="@+id/heading_slider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="-180.0"
                android:valueTo="180.0"
                android:value="0.0"
                app:labelBehavior="gone"
                />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
