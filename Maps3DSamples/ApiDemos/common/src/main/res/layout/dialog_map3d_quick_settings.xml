<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Map Mode Section Header -->
        <TextView
            android:id="@+id/tv_header_map_mode"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map3d_mode_section"
            android:textColor="?attr/colorPrimary" />

        <!-- Map Mode Radio Group -->
        <RadioGroup
            android:id="@+id/rg_map_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_mode_satellite"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_mode_satellite" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_mode_hybrid"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_mode_hybrid" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_mode_roadmap"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_mode_roadmap" />
        </RadioGroup>

        <!-- Section Divider -->
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- Color Scheme Section Header -->
        <TextView
            android:id="@+id/tv_header_color_scheme"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/map3d_color_scheme_section"
            android:textColor="?attr/colorPrimary" />

        <!-- Color Scheme Radio Group -->
        <RadioGroup
            android:id="@+id/rg_color_scheme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_scheme_system"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_color_scheme_system" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_scheme_light"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_color_scheme_light" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rb_scheme_dark"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_color_scheme_dark" />
        </RadioGroup>

        <!-- Section Divider -->
        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <!-- UI Controls Section Header & Master Toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_header_ui_controls"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map3d_controls_section"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_toggle_all_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/map3d_controls_toggle_all" />
        </LinearLayout>

        <!-- Individual Control Checkboxes -->
        <LinearLayout
            android:id="@+id/container_control_checkboxes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_control_zoom"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_control_zoom" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_control_tilt"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_control_tilt" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_control_rotate"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_control_rotate" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_control_compass"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_control_compass" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_control_pan_v"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_control_pan_v" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/cb_control_pan_h"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/map3d_control_pan_h" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
