<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="8dp"
    app:cardCornerRadius="16dp"
    android:layout_margin="12dp"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <!-- Card Header with title and collapse/expand button -->
        <LinearLayout
            android:id="@+id/card_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            >

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_controls_panel_title"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textStyle="bold"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_collapse"
                style="?attr/materialIconButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="0dp"
                app:icon="@drawable/expand_more_24px"
                app:iconSize="20dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/collapse_controls"
                />
        </LinearLayout>

        <!-- Collapsible Content Section -->
        <LinearLayout
            android:id="@+id/card_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            >

            <!-- Quick Preset Buttons: Show All / Hide All -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_controls_visibility_label"
                    style="@style/TextAppearance.Material3.LabelMedium"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_show_all"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="@string/ui_controls_show_all"
                    />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_hide_all"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="0dp"
                    android:text="@string/ui_controls_hide_all"
                    />
            </LinearLayout>

            <!-- FilterChips for individual 3D Camera UI Controls -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="false"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="2dp"
                >

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_zoom"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/ui_control_chip_zoom"
                    />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_tilt"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/ui_control_chip_tilt"
                    />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_rotate"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/ui_control_chip_rotate"
                    />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pan_vertical"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/ui_control_chip_pan_vertical"
                    />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_pan_horizontal"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/ui_control_chip_pan_horizontal"
                    />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_compass"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:checked="true"
                    android:text="@string/ui_control_chip_compass"
                    />
            </com.google.android.material.chip.ChipGroup>

            <!-- Placement Toggle Section: Trailing (Right) vs Leading (Left) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/ui_controls_placement_label"
                style="@style/TextAppearance.Material3.LabelMedium"
                />

            <RadioGroup
                android:id="@+id/rg_controls_placement"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                >

                <RadioButton
                    android:id="@+id/rb_placement_trailing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="@string/ui_controls_placement_trailing"
                    />

                <RadioButton
                    android:id="@+id/rb_placement_leading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ui_controls_placement_leading"
                    />
            </RadioGroup>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
