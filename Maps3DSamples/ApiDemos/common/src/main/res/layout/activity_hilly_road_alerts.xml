<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:map3d="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fullscreen 3D Map View in Hybrid mode -->
    <com.google.android.gms.maps3d.Map3DView
        android:id="@+id/map3dView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        map3d:mapMode="hybrid"
        map3d:centerLat="36.485940"
        map3d:centerLng="-114.532890"
        map3d:centerAlt="614.4"
        map3d:heading="0"
        map3d:tilt="74"
        map3d:range="160"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top AppBar with Navigation Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#800F172A"
        app:elevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_bar"
            style="@style/Widget.MaterialComponents.Toolbar.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:title="@string/feature_title_hilly_road_alerts"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Top Early Warning HUD Banner + Live Elevation Sparkline Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/hud_alert_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="60dp"
        app:cardBackgroundColor="#E61E293B"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:strokeColor="#FBBC04"
        app:strokeWidth="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/app_bar_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Alert Title & Early Distance Pill Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_alert_title"
                    style="@style/TextAppearance.Material3.TitleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/hilly_alert_title_roller_coaster"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_alert_distance_pill"
                    style="@style/TextAppearance.Material3.LabelMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/pill_background"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="@string/hilly_alert_distance_clear"
                    android:textColor="@android:color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Telemetry Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_chip_extrema"
                        style="@style/TextAppearance.Material3.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/pill_background"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#E2E8F0" />

                    <TextView
                        android:id="@+id/tv_chip_max_grade"
                        style="@style/TextAppearance.Material3.LabelSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/pill_background"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:textColor="#E2E8F0" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Live Lookahead Elevation Sparkline -->
            <TextView
                android:id="@+id/tv_sparkline_label"
                style="@style/TextAppearance.Material3.LabelSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#94A3B8" />

            <com.example.maps3d.common.ElevationSparklineView
                android:id="@+id/sparkline_view"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 3D Map Quick Settings FAB -->
    <com.example.maps3d.common.Map3DQuickSettingsButton
        android:id="@+id/quick_settings_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="12dp"
        android:elevation="8dp"
        android:translationZ="8dp"
        app:fabCustomSize="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Compact Collapsible Bottom Control Sheet -->
    <androidx.cardview.widget.CardView
        android:id="@+id/controls_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical">

            <!-- Drag Handle -->
            <FrameLayout
                android:id="@+id/layout_drag_handle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="6dp"
                android:paddingBottom="2dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:alpha="0.6"
                    android:background="@drawable/drag_handle_bar" />
            </FrameLayout>

            <!-- Pinned Header: Title, Jump to Hills Quick Action, and Collapse Toggle -->
            <LinearLayout
                android:id="@+id/card_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Material3.TitleSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hilly_road_controls_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_current_telemetry"
                        style="@style/TextAppearance.Material3.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8" />
                </LinearLayout>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_jump_to_hills"
                    style="@style/Widget.Material3.Chip.Assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hilly_jump_to_hills" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_collapse"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/collapse_controls"
                    app:icon="@drawable/expand_more_24px"
                    app:iconTint="?attr/colorOnSurface" />
            </LinearLayout>

            <!-- Pinned Play/Pause & Progress Scrubber Row -->
            <LinearLayout
                android:id="@+id/layout_persistent_playback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_play_pause"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:contentDescription="@string/play_or_pause_animation"
                    app:icon="@drawable/pause_24px" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/progress_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="1.0" />
            </LinearLayout>

            <!-- Expandable Body capped via MaxHeightScrollView -->
            <com.example.maps3d.common.MaxHeightScrollView
                android:id="@+id/controls_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="210dp"
                android:scrollbars="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <!-- Route Preset Chips -->
                    <TextView
                        style="@style/TextAppearance.Material3.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hilly_route_preset_label"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_route"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_route_roller_coaster"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/hilly_route_roller_coaster" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_route_mountain_pass"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hilly_route_mountain_pass" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_route_coastal"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/hilly_route_coastal" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Lookahead Horizon Chips -->
                    <TextView
                        style="@style/TextAppearance.Material3.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hilly_lookahead_horizon_label"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_horizon"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:selectionRequired="true"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_horizon_250"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hilly_horizon_250m" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_horizon_500"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/hilly_horizon_500m" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_horizon_750"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hilly_horizon_750m" />
                    </com.google.android.material.chip.ChipGroup>

                    <!-- Speed Preset Chips -->
                    <TextView
                        style="@style/TextAppearance.Material3.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hilly_speed_label"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chip_group_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_speed_05x"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_05x" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_speed_1x"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:checked="true"
                                android:text="@string/speed_1x" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_speed_2x"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_2x" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_speed_3x"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_3x" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chip_speed_5x"
                                style="@style/Widget.Material3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/speed_5x" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>

                    <!-- Crest Camera Preview Switch -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_camera_preview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:checked="true"
                        android:text="@string/hilly_crest_camera_preview" />
                </LinearLayout>
            </com.example.maps3d.common.MaxHeightScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
